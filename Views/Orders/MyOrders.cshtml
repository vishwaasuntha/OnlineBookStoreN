@model List<OnlineBookStore.Models.Order>

<h2>My Orders</h2>

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <th>Date</th>
        <th>Total</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    @foreach (var o in Model)
    {
        <tr>
            <td>@o.Id</td>
            <td>@o.OrderDate</td>
            <td>@o.TotalAmount</td>
            <td>@o.Status</td>
            <td>
                <a href="/Orders/Details/@o.Id" class="btn btn-info btn-sm">View</a>
            </td>
        </tr>
    }

</table>