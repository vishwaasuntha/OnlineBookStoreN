@model OnlineBookStore.Models.ViewModels.HomeViewModel

<h2>Books</h2>

<form method="get" class="mb-3">
    <input type="text" name="search" class="form-control" placeholder="Search books..." />
</form>

<h2>Categories</h2>

<div class="row">

    @foreach (var c in Model.Categories)
    {
        <div class="col-md-3 mb-3">

            <a href="/Home/BooksByCategory/@c.Id"
               class="text-decoration-none">

                <div class="card p-3 text-center shadow">
                    <h5>@c.Name</h5>
                </div>

            </a>

        </div>
    }

</div>

<hr />
<h2>Books</h2>

<div class="row">

    @foreach (var item in Model.Books)
    {
        <div class="col-md-3 mb-3">

            <div class="card h-100">

                <img src="@item.ImageUrl"
                     class="card-img-top"
                     style="height:200px;" />

                <div class="card-body">

                    <h5>@item.Title</h5>
                    <p>@item.Author</p>
                    <h6>Euro. @item.Price</h6>

                    <a href="/Books/Details/@item.Id"
                       class="btn btn-primary btn-sm">View</a>

                    <a href="/Cart/AddToCart?bookId=@item.Id"
                       class="btn btn-success btn-sm">Add</a>

                </div>

            </div>

        </div>
    }

</div>