<form method="post" class="w-50 mx-auto">

    <h2>Register</h2>

    <input name="FullName" class="form-control mb-2" placeholder="Full Name" />

    <input name="Email" class="form-control mb-2" placeholder="Email" />

    <input name="PasswordHash" type="password" class="form-control mb-2" placeholder="Password" />

    <input name="ConfirmPassword" type="password" class="form-control mb-2" placeholder="Confirm Password" />

    <button class="btn btn-success w-100">Register</button>

</form>