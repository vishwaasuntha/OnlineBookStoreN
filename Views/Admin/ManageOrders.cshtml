@model List<OnlineBookStore.Models.Order>

@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container mt-4">

    <h2>Manage Orders</h2>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer Name</th>
                <th>Emai</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <!-- CUSTOMER NAME -->

                    <td>@item.User.FullName</td>

                    <!-- CUSTOMER EMAIL -->
                    <td>@item.User.Email</td>

                    <td>@item.OrderDate</td>

                    @*   <td>@item.UserId</td>*@
                  @*  <td>@item.OrderDate</td>*@
                    <td>@item.TotalAmount</td>
                    <td>@item.Status</td>

                    <td>
                        <a class="btn btn-success btn-sm"
                           href="/Admin/UpdateStatus?id=@item.Id&status=Processing">
                            Processing
                        </a>

                        <a class="btn btn-primary btn-sm"
                           href="/Admin/UpdateStatus?id=@item.Id&status=Shipped">
                            Shipped
                        </a>

                        <a class="btn btn-danger btn-sm"
                           href="/Admin/UpdateStatus?id=@item.Id&status=Cancelled">
                            Cancel
                        </a>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>