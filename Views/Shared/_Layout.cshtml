<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Online Book Store</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            @{
                var user = Context.Session.GetString("UserName");
            }


            <a class="navbar-brand" href="/">Book Store</a>

            <div class="navbar-nav ms-auto">

                @{
                    var role = Context.Session.GetString("Role");
                }

                @if (role == "Admin")
                {
                    <a class="nav-link text-white" href="/Admin/Dashboard">Home</a>
                }
                else
                {
                    <a class="nav-link text-white" href="/Home/Index">Home</a>
                }

                @if (role != "Admin")
                {
                    <a class="nav-link text-white" href="/Cart/Index">Cart</a>
                    <a class="nav-link text-white" href="/Orders/MyOrders">Orders</a>
                }

                <!--    <a class="nav-link text-white" href="/Home/Index">Home</a>-->
                <!--    <a class="nav-link text-white" href="/Cart/Index">Cart</a>
                <a class="nav-link text-white" href="/Orders/MyOrders">Orders</a>-->

              @if (string.IsNullOrEmpty(user))
                {
                    <a class="nav-link text-white" asp-controller="Account" asp-action="Login">
                        Login
                    </a>

                    <a class="nav-link text-white" href="/Account/Register">
                        Register
                    </a>
                }
                else
                {
                <!--   <a class="nav-link text-white" href="/Account/Login">Login</a>-->
                <!--    <a class="nav-link text-white" href="/Account/Register">Register</a>-->
                <a class="nav-link text-danger"
                   asp-controller="Account"
                   asp-action="Logout">
                    Logout
                </a>
                }
         
            </div>

        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

</body>
</html>